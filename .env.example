# Copy this file to ".env" (same folder) and fill in values you want to use.
# The app works without any of these. Placeholders only: never commit a real key.

# Optional. Needed only for Gemini-powered features. Get a key from Google AI Studio.
GEMINI_API_KEY=

# Model name is configurable. Model names and free-tier limits change over time,
# so check Google's current documentation if requests fail with "model not found".
GEMINI_MODEL=gemini-2.5-flash

# Seconds to wait for a response, and retries for transient errors (rate limit, 5xx).
AWI_REQUEST_TIMEOUT=60
AWI_MAX_RETRIES=2

# Optional: change where the database, exports and logs live.
# Default on Windows: %LOCALAPPDATA%\AdaptiveWritingIntelligence
# AWI_DATA_DIR=

# Upload and input limits
AWI_MAX_UPLOAD_MB=5
AWI_MAX_INPUT_CHARS=60000
